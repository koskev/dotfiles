{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "recreateWhen": "always",
    "rebaseWhen": "behind-base-branch",
    "schedule": [
      "* 3 * * *"
    ],
    "automerge": true,
    "automergeType": "branch",
    "ignoreTests": false
  },
  "nix": {
    "managerFilePatterns": [
      "/(^|/)flake\\.nix$/"
    ],
    "commitMessageTopic": "nix",
    "commitMessageExtra": "to {{newValue}}",
    "enabled": true
  },
  "github-actions": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        // See https://docs.renovatebot.com/modules/manager/regex/#regular-expression-capture-groups
        // Matches: 
        // # renovate: datasource=docker
        // image = "myImage:1.234@sha256:abc";
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s*image\\s*=\\s*\"(?<depName>[^:]+):(?<currentValue>[^@\"]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\";"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "terraform-provider",
        "terraform-module"
      ],
      "registryUrls": [
        "https://registry.opentofu.org"
      ]
    }
  ]
}
